FROM golang:1.23-alpine@sha256:383395b794dffa5b53012a212365d40c8e37109a626ca30d6151c8348d380b5f AS metricshell
WORKDIR /src
ARG VERSION=0.0.0-research
COPY ["go.mod", "./"]
COPY ["cmd", "./cmd/"]
RUN CGO_ENABLED=0 go build -trimpath -buildvcs=false -ldflags="-s -w -X main.version=${VERSION}" -o /out/metricshell ./cmd/inv013

FROM php:8.3-cli-alpine@sha256:afdf8b1fee58486ccc0dab5f30f634b86873d56dac985f71ba217945647c05ad
ARG VERSION=0.0.0-research
LABEL org.opencontainers.image.title="Application multi-stage example" \
      org.opencontainers.image.version="${VERSION}"
COPY --from=metricshell /out/metricshell /usr/local/bin/metricshell
RUN addgroup -S application && adduser -S -G application application
USER application
ENTRYPOINT ["/usr/local/bin/metricshell"]
